# Copy to .env in the repo root — never commit the real file.
#   cp .env.example .env
#
# Single source of truth for the API, Docker Compose, and research scripts.

# --- Neo4j (app-isolated container; Bolt on host 7688) ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=capco-graph-change-me

# --- Postgres + pgvector (host 5433) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=capco
POSTGRES_PASSWORD=capco-regulation-change-me
POSTGRES_DB=regulation_assistant

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Display / limits ---
TOTAL_COUNT=1174
GRAPH_MAX_NODES=500
GRAPH_REG_LIMIT=200
LLM_TIMEOUT_TEST=10
LLM_TIMEOUT_ASK=30

# --- OpenAI-compatible API (embeddings + optional server-side chat) ---
# Chat UI can also send credentials per-request from the browser Settings page.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Firecrawl (research scrape scripts only)
# FIRECRAWL_API_KEY=
